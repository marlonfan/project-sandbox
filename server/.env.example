# 项目沙盘服务端环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会进版本库

# ---- SMTP（注册验证码发信，必填）----
PSB_SMTP_HOST=smtp.example.com
PSB_SMTP_PORT=465
PSB_SMTP_USER=noreply@example.com
PSB_SMTP_PASS=授权码或密码
PSB_SMTP_FROM=项目沙盘

# ---- 可选 ----
# PSB_ADDR=:8787          # 监听地址
# PSB_DB=sandbox.db       # SQLite 数据库路径
# PSB_HTML=../project-sandbox.html  # 前端文件路径
# PSB_DEBUG=1             # 验证码打印到日志（仅排查用）
